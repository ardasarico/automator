# Server-only URL. Railway uses the API service's private domain.
API_URL=http://localhost:3001

# Public Privy application identifier; never put the app secret here.
NEXT_PUBLIC_PRIVY_APP_ID=

# Public URL of the runtime app; the builder's screen preview opens flows there.
NEXT_PUBLIC_RUNTIME_URL=http://localhost:3002

# Privy key quorum id of the API's authorization key (Privy dashboard → Wallet
# infrastructure → Authorization keys). Shown to users as "Enable server signing";
# leave blank to hide the option.
NEXT_PUBLIC_PRIVY_SIGNER_ID=

# Test only, never on Railway: set by the Playwright suite's own web server so the browser
# has a session without Privy. Production builds ignore it.
NEXT_PUBLIC_E2E_TOKEN=
