# Local development uses the public URL of the same Railway Postgres as production.
# Use the Postgres public TCP endpoint and database credentials from Railway.
DATABASE_URL=postgresql://USER:PASSWORD@PUBLIC_HOST:PUBLIC_PORT/railway?sslmode=require
PORT=3001

# Privy server credentials. Keep the app secret in the API only.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Public verification key from the Privy dashboard (Settings, JWT verification key).
# Required in production: tokens are then verified locally and the API never
# fetches JWKS. Without it a failed JWKS fetch is indistinguishable from a forged
# token, so an upstream outage logs users out with 401 instead of failing loudly.
PRIVY_VERIFICATION_KEY=

# OpenRouter, for AI nodes and the flow generator. Optional: without a key the AI
# routes answer 503 and AI nodes fail their run as unconfigured. Any model id from
# https://openrouter.ai/models that supports tools and JSON-schema answers works; the
# default (a free model) is used when OPENROUTER_MODEL is blank. A paid alternative:
# openai/gpt-4o-mini.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free

# 32 random bytes in base64, encrypting user secrets (Variables panel) at rest. Required
# in production; generate one with: openssl rand -base64 32
SECRETS_KEY=

# Chains for onchain nodes come from the registry in packages/contracts/src/chains.ts
# (Base Sepolia 84532 and World Chain Sepolia 4801, each with its public RPC and Circle's
# testnet USDC); a flow picks its chain in the builder's flow settings. CHAIN_RPC_URL_<id>
# replaces one chain's RPC (for example an Alchemy URL, or `anvil --fork-url ...` to run
# that chain's live runs against a fork). The older CHAIN_ID / CHAIN_RPC_URL / USDC_ADDRESS
# trio still overrides the chain CHAIN_ID names; a per-chain URL wins over it.
CHAIN_RPC_URL_84532=
CHAIN_RPC_URL_4801=
CHAIN_ID=84532
CHAIN_RPC_URL=https://sepolia.base.org
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Private key of the Privy authorization key (dashboard → Wallet infrastructure →
# Authorization keys), base64 PKCS8 without PEM headers. Lets the API sign with users'
# embedded wallets once they enable server signing in the builder. Optional: without it
# reads and dry-run simulations still work and writing nodes fail with a clear message.
PRIVY_AUTHORIZATION_KEY=

# Optional: calls per minute before the API answers 429, per user (runs, AI, secret writes),
# per client address (mini-app sessions) or per flow (webhooks). Blank keeps the defaults
# 30, 10, 30, 60 and 60.
RATE_LIMIT_RUNS=
RATE_LIMIT_AI=
RATE_LIMIT_SECRETS=
RATE_LIMIT_SESSIONS=
RATE_LIMIT_WEBHOOKS=

# World ID for "World ID verify" nodes in mini-apps, from the World Developer Portal
# (https://developer.world.org): the app id, the relying party id and its signing key that
# come with the app once World ID 4.0 is enabled (the key is a secret: the API signs every
# proof request with it, the runtime never sees it). The API verifies proofs with the portal's
# public verify endpoint, so no API key is needed. All three together or none: without them
# those nodes fail their run as unconfigured. WORLD_ENVIRONMENT is production, staging (for
# the simulator at https://simulator.worldcoin.org) or sandbox; blank means production.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ENVIRONMENT=

# Development and test only: a bearer token the API accepts as the fixed user did:privy:e2e,
# used by the Playwright suite (`bun run e2e`). The API refuses to start with it in production.
E2E_TEST_TOKEN=
