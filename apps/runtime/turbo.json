{
  "extends": ["//"],
  "tasks": {
    "dev": {
      "passThroughEnv": ["PORT", "API_URL"]
    },
    "start": {
      "passThroughEnv": ["PORT", "API_URL"]
    },
    "build": {
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "env": ["API_URL"]
    },
    "typecheck": {
      "outputs": [".next/types/**", "*.tsbuildinfo"]
    }
  }
}
