# Server-only URL. Railway uses the API service's private domain.
API_URL=http://localhost:3001

# Public Privy application identifier, the same app as the dashboard, for "Privy login"
# screens in published mini-apps. Never put the app secret here. Blank makes those screens
# say sign-in is unavailable. World ID screens need nothing here: the API sends each screen
# its signed request context.
NEXT_PUBLIC_PRIVY_APP_ID=
