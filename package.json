{
  "name": "automator",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "bun run --cwd apps/web e2e",
    "lint": "turbo run lint lint:config",
    "lint:fix": "turbo run lint lint:config -- --fix",
    "lint:config": "oxlint --deny-warnings .railway",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "railway": "3.11.0",
    "turbo": "2.10.12"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.13"
}
