{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "nextjs", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["**/node_modules/**", "**/.next/**", "**/dist/**", "**/next-env.d.ts"],
  "rules": {
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "overrides": [
    {
      "files": [
        "apps/web/**/*.{ts,tsx}",
        "packages/contracts/**/*.{ts,tsx}",
        "apps/runtime/**/*.{ts,tsx}",
        "packages/ui/**/*.{ts,tsx}",
        "packages/api-client/**/*.{ts,tsx}",
        "apps/ui-lab/**/*.{ts,tsx}"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@automator/db",
                  "@automator/db/**",
                  "**/packages/db",
                  "**/packages/db/**",
                  "pg",
                  "pg/**",
                  "postgres",
                  "postgres/**",
                  "drizzle-orm",
                  "drizzle-orm/**",
                  "@prisma/client",
                  "@prisma/client/**",
                  "bun:sqlite"
                ],
                "message": "Frontend apps and shared frontend packages must access data through the API."
              }
            ],
            "paths": [
              {
                "name": "bun",
                "importNames": ["SQL", "sql", "default", "*"],
                "message": "Keep Bun SQL access in the API and database package."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "apps/web/**/*.{ts,tsx}",
        "apps/runtime/**/*.{ts,tsx}",
        "packages/ui/**/*.{ts,tsx}",
        "packages/api-client/**/*.{ts,tsx}",
        "packages/contracts/**/*.{ts,tsx}",
        "apps/ui-lab/**/*.{ts,tsx}"
      ],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "property": "DATABASE_URL",
            "message": "Database credentials belong only in the API and database package."
          }
        ]
      }
    }
  ]
}
